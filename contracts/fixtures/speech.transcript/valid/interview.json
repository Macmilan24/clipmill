      "end_ticks": 225000,
      "first_word_index": 0,
      "index": 0,
      "start_ticks": 0,
      "text": "What makes a renderer deterministic?",
      "word_count": 5
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 621000,
      "first_word_index": 5,
      "index": 1,
      "start_ticks": 261000,
      "text": "The encoder settings are pinned to one profile.",
      "word_count": 8
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 1107000,
      "first_word_index": 13,
      "index": 2,
      "start_ticks": 657000,
      "text": "Every frame lands on the same tick on every machine.",
      "word_count": 10
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 1458000,
      "first_word_index": 23,
      "index": 3,
      "start_ticks": 1143000,
      "text": "Nobody can reproduce a build that drifts.",
      "word_count": 7
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 1899000,
      "first_word_index": 30,
      "index": 4,
      "start_ticks": 1494000,
      "text": "That is the whole reason the profile is frozen.",
      "word_count": 9
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 2529000,
      "first_word_index": 39,
      "index": 5,
      "start_ticks": 2259000,
      "text": "How does alignment measure word timing?",
      "word_count": 6
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 2970000,
      "first_word_index": 45,
      "index": 6,
      "start_ticks": 2565000,
      "text": "A CTC model scores each frame against the text.",
      "word_count": 9
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 3321000,
      "first_word_index": 54,
      "index": 7,
      "start_ticks": 3006000,
      "text": "The peaks become word boundaries in ticks.",
      "word_count": 7
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 3762000,
      "first_word_index": 61,
      "index": 8,
      "start_ticks": 3357000,
      "text": "Interpolated timing is labelled and never presented as measured.",
      "word_count": 9
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 4293000,
      "first_word_index": 70,
      "index": 9,
      "start_ticks": 3798000,
      "text": "Precision here is what stops a cut landing inside a word.",
      "word_count": 11
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 4968000,
      "first_word_index": 81,
      "index": 10,
      "start_ticks": 4653000,
      "text": "What breaks when the timebase is wrong?",
      "word_count": 7
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 5454000,
      "first_word_index": 88,
      "index": 11,
      "start_ticks": 5004000,
      "text": "A caption drifts a frame further out with every cut.",
      "word_count": 10
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 5895000,
      "first_word_index": 98,
      "index": 12,
      "start_ticks": 5490000,
      "text": "Viewers read it as sloppiness rather than as arithmetic.",
      "word_count": 9
    },
    {
      "confidence": {
        "p10": 0.86,
        "p50": 0.95
      },
      "end_ticks": 6336000,
      "first_word_index": 107,
      "index": 13,
      "start_ticks": 5931000,
      "text": "Integer ticks against a stated timebase remove the question.",
      "word_count": 9
    }
  ],
