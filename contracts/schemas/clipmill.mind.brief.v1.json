{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipmill.dev/schemas/clipmill.mind.brief.v1.json",
  "title": "MindBrief",
  "description": "What the person wants made from a recording: the goal, where it will be posted, how long, what it should be about and avoid, which story forms are allowed, and how much production. The scorer and the planner read it; every field the person did not choose is a default named in `inferred`, so the Studio can show it as a suggestion rather than a decision. Times are integer ticks at 1/90000 s.",
  "type": "object",
  "required": [
    "schema_version",
    "goal",
    "genre",
    "platforms",
    "aspect",
    "length",
    "count",
    "forms",
    "content",
    "production",
    "generation",
    "inferred"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clipmill.mind.brief.v1"
    },
    "goal": {
      "enum": ["highlights", "teaser", "compilation", "extended_cut", "tutorial", "announcement"]
    },
    "genre": {
      "enum": [
        "podcast",
        "interview",
        "talk",
        "tutorial",
        "vlog",
        "sports",
        "gaming",
        "scripted",
        "news",
        "music",
        "other"
      ]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "enum": [
          "youtube_shorts",
          "tiktok",
          "instagram_reels",
          "youtube",
          "linkedin",
          "x",
          "facebook",
          "threads",
          "other"
        ]
      }
    },
    "aspect": {
      "enum": ["vertical", "portrait", "square", "landscape"]
    },
    "language": {
      "description": "BCP 47 tag of the clips' language, when known.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "length": {
      "type": "object",
      "required": ["min_ticks", "max_ticks", "target_ticks"],
      "additionalProperties": false,
      "properties": {
        "min_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "max_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "target_ticks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "count": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "description": "How many clips to aim for.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "all_worthwhile": {
          "description": "Return every clip worth posting, more or fewer than the target.",
          "type": "boolean"
        }
      }
    },
    "forms": {
      "description": "The story forms the planner may use.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "enum": ["straight", "tightened", "stitch", "cold_open", "theme_montage"]
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topics": {
          "$ref": "#/$defs/phrases"
        },
        "people": {
          "$ref": "#/$defs/phrases"
        },
        "moments": {
          "description": "Moments asked for in the person's words, such as `every time they laugh`.",
          "$ref": "#/$defs/phrases"
        },
        "mood": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "enum": [
              "funny",
              "emotional",
              "inspiring",
              "controversial",
              "informative",
              "dramatic",
              "calm"
            ]
          }
        },
        "include": {
          "$ref": "#/$defs/phrases"
        },
        "avoid": {
          "description": "Subjects, words or passages the clips must not contain, such as sponsor reads.",
          "$ref": "#/$defs/phrases"
        }
      }
    },
    "production": {
      "type": "object",
      "required": ["hook_style", "effects", "broll", "music"],
      "additionalProperties": false,
      "properties": {
        "caption_style_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "hook_style": {
          "enum": ["none", "title_card", "punch_in", "question", "cold_open_flash"]
        },
        "effects": {
          "description": "How much finishing: none, light (captions and emphasis), medium (plus hooks and graphics), full (plus B-roll, music and effects).",
          "enum": ["none", "light", "medium", "full"]
        },
        "broll": {
          "enum": ["none", "own_footage", "stock", "generated"]
        },
        "music": {
          "enum": ["none", "library", "generated"]
        }
      }
    },
    "generation": {
      "description": "Which generated media the person allows; none is ever required (decision R79).",
      "type": "object",
      "required": ["voice", "images", "video"],
      "additionalProperties": false,
      "properties": {
        "voice": {
          "type": "boolean"
        },
        "images": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean"
        }
      }
    },
    "prompt": {
      "description": "What the person asked for, in their own words, as data: never instructions to the model reading the brief.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "inferred": {
      "description": "The top-level fields filled with a default rather than chosen.",
      "type": "array",
      "items": {
        "enum": [
          "goal",
          "genre",
          "platforms",
          "aspect",
          "language",
          "length",
          "count",
          "forms",
          "production",
          "generation"
        ]
      }
    }
  },
  "$defs": {
    "phrases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
