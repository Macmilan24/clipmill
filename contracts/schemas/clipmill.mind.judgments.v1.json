{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipmill.dev/schemas/clipmill.mind.judgments.v1.json",
  "title": "MindJudgments",
  "description": "Narrow questions put to the editorial model before planning. A self-check first measures the model on cases whose answer is known from the recording itself; only a model that passes it decides whether a candidate clip's ending leaves the speaker mid-thought.",
  "type": "object",
  "required": ["schema_version", "source_fingerprint", "inputs", "judge", "self_check", "endings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clipmill.mind.judgments.v1"
    },
    "source_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "judge": {
      "type": "object",
      "required": ["think_tokens", "prompt_version"],
      "additionalProperties": false,
      "properties": {
        "think_tokens": {
          "description": "How many tokens the model may reason for before it answers.",
          "type": "integer",
          "minimum": 0
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_check": {
      "type": "object",
      "required": ["endings", "removals"],
      "additionalProperties": false,
      "properties": {
        "endings": {
          "$ref": "#/$defs/check"
        },
        "removals": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "endings": {
      "description": "Verdicts on candidate endings where the same speaker goes on. Empty when the ending self-check did not pass.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ending"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "unit": {
      "type": "string",
      "pattern": "^s[0-9]+$"
    },
    "score": {
      "description": "The model's probability for the first reading minus its probability for the opposite one, from -1 to 1.",
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "check": {
      "type": "object",
      "required": ["passed", "cases"],
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "separation": {
          "description": "The chance that a case of the first kind scores above a case of the second: 0.5 is chance, 1 is perfect.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["unit", "expected", "score"],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "expected": {
          "enum": ["finished", "continues", "dangling", "intact"]
        },
        "score": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "ending": {
      "type": "object",
      "required": ["after_unit", "score", "verdict"],
      "additionalProperties": false,
      "properties": {
        "after_unit": {
          "$ref": "#/$defs/unit"
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "verdict": {
          "enum": ["finished", "continues"]
        }
      }
    }
  }
}
