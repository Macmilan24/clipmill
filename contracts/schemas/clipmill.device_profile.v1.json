{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipmill.dev/schemas/clipmill.device_profile.v1.json",
  "title": "DeviceProfile",
  "description": "The measured device profile (book ch. 11): backend selection is driven by measurement, not static per-platform defaults (D19). Cached as an artifact; re-measured when hardware or runtimes change. Rates (fps, bytes/s) are measurements, not timeline positions, so they may be numbers.",
  "type": "object",
  "required": ["schema_version", "platform", "cpu", "memory", "accelerators", "measured"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clipmill.device_profile.v1"
    },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": { "enum": ["macos", "linux", "windows"] },
        "arch": { "enum": ["arm64", "x86_64"] },
        "os_version": { "type": "string" }
      }
    },
    "cpu": {
      "type": "object",
      "required": ["model", "logical_cores"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "physical_cores": { "type": "integer", "minimum": 1 },
        "performance_cores": { "type": "integer", "minimum": 0 },
        "efficiency_cores": { "type": "integer", "minimum": 0 }
      }
    },
    "memory": {
      "type": "object",
      "required": ["total_bytes"],
      "additionalProperties": false,
      "properties": {
        "total_bytes": { "type": "integer", "minimum": 0 },
        "unified": {
          "description": "True on unified-memory architectures (Apple Silicon).",
          "type": "boolean"
        }
      }
    },
    "accelerators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["metal", "cuda", "vulkan", "videotoolbox", "vaapi", "cpu"] },
          "name": { "type": "string" },
          "vram_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "measured": {
      "description": "Micro-benchmark results from the pinned FFmpeg build.",
      "type": "object",
      "required": ["ffmpeg_build"],
      "additionalProperties": false,
      "properties": {
        "ffmpeg_build": {
          "description": "The bom.toml build identifier the measurements were taken with.",
          "type": "string"
        },
        "decode": { "$ref": "#/$defs/codec_bench_list" },
        "encode": { "$ref": "#/$defs/codec_bench_list" }
      }
    },
    "phase0": {
      "description": "Measured Phase 0 scheduler and attestation extension. Legacy v1 profiles omit it; every new Phase 0 profile includes it.",
      "type": "object",
      "required": [
        "hardware_fingerprint",
        "measurement_generation",
        "available_memory_bytes",
        "runtime_identities",
        "capability_results",
        "shared_memory",
        "hardware_roundtrip",
        "attestation"
      ],
      "additionalProperties": false,
      "properties": {
        "hardware_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "measurement_generation": {
          "type": "integer",
          "minimum": 1
        },
        "available_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_identity" }
        },
        "capability_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability_result" }
        },
        "shared_memory": {
          "$ref": "#/$defs/shared_memory_benchmark"
        },
        "hardware_roundtrip": {
          "$ref": "#/$defs/hardware_roundtrip"
        },
        "attestation": {
          "$ref": "#/$defs/device_attestation"
        }
      }
    },
    "selection": {
      "description": "Which implementation each model-running capability is bound to on this device, and the measurement that decided it (D19). Absent on profiles taken before any capability had candidates. A binding names one implementation; the candidate list beside it is the evidence, including the candidates that could not run here and why — a device that cannot say why it rejected an implementation cannot be asked to justify its choice.",
      "type": "object",
      "required": ["bindings", "candidates"],
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementation_binding" }
        },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementation_candidate" }
        }
      }
    }
  },
  "$defs": {
    "implementation_binding": {
      "description": "One capability's chosen implementation, and how it was chosen.",
      "type": "object",
      "required": ["capability", "stage", "implementation", "model", "backend", "selected_by"],
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1, "maxLength": 64 },
        "stage": { "type": "string", "minLength": 1, "maxLength": 64 },
        "implementation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "backend": { "type": "string", "minLength": 1, "maxLength": 64 },
        "selected_by": {
          "description": "measured — a benchmark ranked two or more runnable candidates. sole_candidate — only one candidate could run here, so nothing was ranked. unmeasured_fallback — candidates exist but no valid benchmark covers this device, so the portable one was taken. The three are kept apart because a choice nobody measured must never read as one somebody did.",
          "enum": ["measured", "sole_candidate", "unmeasured_fallback"]
        },
        "detail": { "type": "string", "maxLength": 512 }
      }
    },
    "implementation_candidate": {
      "description": "One implementation that could serve a capability, measured over the benchmark fixture or refused with a reason.",
      "type": "object",
      "required": ["capability", "implementation", "model", "model_digest", "backend", "runnable"],
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1, "maxLength": 64 },
        "implementation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model_digest": {
          "description": "The registry identity the measurement was taken against. A re-pinned model is a different model, so a measurement carrying the old digest is stale rather than merely old.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "backend": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runnable": { "type": "boolean" },
        "real_time_factor": {
          "description": "Benchmark audio seconds divided by wall-clock seconds. Above 1 is faster than real time. A rate, not a timeline position.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "peak_resident_bytes": { "type": "integer", "minimum": 1 },
        "unavailable_reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "oneOf": [
        {
          "properties": { "runnable": { "const": true } },
          "required": ["real_time_factor", "peak_resident_bytes"],
          "not": { "required": ["unavailable_reason"] }
        },
        {
          "properties": { "runnable": { "const": false } },
          "required": ["unavailable_reason"],
          "not": { "required": ["real_time_factor"] }
        }
      ]
    },
    "codec_bench_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codec", "height", "fps_measured"],
        "additionalProperties": false,
        "properties": {
          "codec": { "type": "string" },
          "height": { "type": "integer", "minimum": 1 },
          "fps_measured": { "type": "number", "exclusiveMinimum": 0 },
          "hardware": {
            "description": "True when a hardware path (VideoToolbox, NVDEC, …) was used.",
            "type": "boolean"
          }
        }
      }
    },
    "runtime_identity": {
      "type": "object",
      "required": ["kind", "identity", "available"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "available": { "type": "boolean" }
      }
    },
    "capability_result": {
      "type": "object",
      "required": ["capability", "backend", "available"],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "available": { "type": "boolean" },
        "detail": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "shared_memory_benchmark": {
      "type": "object",
      "required": ["sample_bytes", "bytes_per_second"],
      "additionalProperties": false,
      "properties": {
        "sample_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "hardware_roundtrip": {
      "type": "object",
      "required": ["backend", "available"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "available": { "type": "boolean" },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "oneOf": [
        {
          "properties": { "available": { "const": true } },
          "required": ["milliseconds"],
          "not": { "required": ["unavailable_reason"] }
        },
        {
          "properties": { "available": { "const": false } },
          "required": ["unavailable_reason"],
          "not": { "required": ["milliseconds"] }
        }
      ]
    },
    "device_attestation": {
      "description": "Signature over RFC 8785 canonical profile JSON with this attestation object omitted.",
      "type": "object",
      "required": ["algorithm", "public_key", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  }
}
