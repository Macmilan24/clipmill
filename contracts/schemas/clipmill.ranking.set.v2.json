{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipmill.dev/schemas/clipmill.ranking.set.v2.json",
  "title": "RankingSetV2",
  "description": "Distinct independently reviewed plans in editorial order, with counterbalanced comparisons, Bradley–Terry strengths and a reason for any shortfall.",
  "type": "object",
  "required": [
    "schema_version",
    "source_fingerprint",
    "inputs",
    "editorial_prompt",
    "requested_count",
    "clips",
    "comparisons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clipmill.ranking.set.v2"
    },
    "source_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "editorial_prompt": {
      "type": "string",
      "maxLength": 1000
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ranked"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "cutoff_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[0-9a-f]{16,64}$"
    },
    "ranked": {
      "type": "object",
      "required": ["plan", "chapter", "reasons", "quality", "keep_score", "strength"],
      "additionalProperties": false,
      "properties": {
        "plan": {
          "description": "A clipmill.mind.clip_plan.v1 document with its validated source geometry.",
          "type": "object"
        },
        "chapter": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "keep_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "strength": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["a", "b", "share_a", "reasons"],
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/plan_id"
        },
        "b": {
          "$ref": "#/$defs/plan_id"
        },
        "share_a": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "quality": {
      "type": "object",
      "required": ["verdict", "hook", "summary", "joins", "issues", "repaired"],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": ["accept", "reject"]
        },
        "hook": {
          "enum": ["strong", "adequate", "weak"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/join_review"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repaired": {
          "type": "boolean"
        },
        "tightened": {
          "description": "A passage was left out by meaning after the clip was accepted, and the shorter clip was reviewed and accepted in turn.",
          "type": "boolean"
        },
        "compared": {
          "description": "The edited clip set against its plain version: the longest part played whole, with nothing left out. An edit ships only when the comparison prefers it in both orders, or when the plain version cannot ship.",
          "type": "object",
          "required": ["plain_plan_id", "kept", "reason"],
          "additionalProperties": false,
          "properties": {
            "plain_plan_id": {
              "$ref": "#/$defs/plan_id"
            },
            "kept": {
              "enum": ["edit", "plain"]
            },
            "reason": {
              "enum": [
                "edit_preferred",
                "plain_preferred",
                "not_measured",
                "plain_failed_review",
                "plain_out_of_length",
                "awaiting_agent"
              ]
            },
            "edit_first": {
              "description": "The probability that the edit is the better short, asked with the edit as version A.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "plain_first": {
              "description": "The probability that the plain version is the better short, asked with it as version A.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "join_review": {
      "type": "object",
      "required": ["after", "verdict", "note"],
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": ["pass", "reject"]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
