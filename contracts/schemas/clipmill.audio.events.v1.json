{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipmill.dev/schemas/clipmill.audio.events.v1.json",
  "title": "AudioEvents",
  "description": "Timed sounds and vocal delivery in the 16 kHz rendition. A tagger detects laughter, applause, cheering, music, shouts and gasps. Emphasis records a sustained rise in pitch or level relative to recent voiced speech. Intervals use 1/90000-second ticks.",
  "type": "object",
  "required": [
    "schema_version",
    "source_fingerprint",
    "audio_artifact_id",
    "producer",
    "detection",
    "coverage",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "clipmill.audio.events.v1"
    },
    "source_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "audio_artifact_id": {
      "description": "The 16 kHz mono rendition this pass read, verified before use.",
      "$ref": "#/$defs/sha256"
    },
    "vad_artifact_id": {
      "description": "Voice-activity evidence used to measure emphasis. Absent on earlier recordings whose producer only tagged sounds.",
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "type": "object",
      "required": ["stage", "implementation", "model_digest"],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "const": "audio-events"
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "model_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "detection": {
      "type": "object",
      "required": ["window_ticks", "hop_ticks", "thresholds"],
      "additionalProperties": false,
      "properties": {
        "window_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "hop_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "thresholds": {
          "description": "Start and continuation scores for the audio tagger's classes.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "on", "off"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "$ref": "#/$defs/kind"
              },
              "on": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "off": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["start_ticks", "end_ticks", "analyzed"],
      "additionalProperties": false,
      "properties": {
        "start_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "end_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "analyzed": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "description": "In time order, then by kind.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "start_ticks", "end_ticks", "peak", "mean"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/$defs/kind"
          },
          "start_ticks": {
            "type": "integer",
            "minimum": 0
          },
          "end_ticks": {
            "type": "integer",
            "minimum": 1
          },
          "peak": {
            "description": "Highest tagger score, or highest normalized periodicity for an emphasis event.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mean": {
            "description": "Mean tagger score, or mean normalized periodicity for an emphasis event.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "delivery": {
            "description": "Measurements on the voiced frames of an emphasis event. Changes are relative to the preceding local median.",
            "type": "object",
            "required": ["pitch_hz", "level_dbfs", "pitch_change_semitones", "level_change_db"],
            "additionalProperties": false,
            "properties": {
              "pitch_hz": { "type": "number", "exclusiveMinimum": 0 },
              "level_dbfs": { "type": "number", "maximum": 0 },
              "pitch_change_semitones": { "type": "number" },
              "level_change_db": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "enum": ["laughter", "applause", "cheering", "music", "shout", "gasp", "emphasis"]
    }
  }
}
