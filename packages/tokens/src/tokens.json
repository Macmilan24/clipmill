{
  "meta": {
    "name": "Pro-Studio Precision",
    "version": "1.0.0",
    "source": "creator-os/design/clipper-stitch-prompts.md, Prompt 00 (master visual direction)",
    "note": "Hand-transcribed in W9. The Stitch export hardcodes per-theme colors on every element; here each themed value exists once per theme and is selected at runtime by one data-theme switch (decision R9: prose and screens are authoritative over the export's front-matter palette)."
  },

  "accent": {
    "default": "#5E6AD2",
    "hover": "#6D79E7",
    "pressed": "#4E59B9",
    "selected": "rgba(94, 106, 210, 0.14)",
    "focus": "rgba(94, 106, 210, 0.42)"
  },

  "semantic": {
    "success": "#3FB27F",
    "warning": "#D9A13B",
    "danger": "#E5484D",
    "outbound": "#D9756B"
  },

  "font": {
    "ui": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },

  "weight": {
    "wordmark": "700",
    "heading": "600",
    "label": "500",
    "body": "400"
  },

  "type": {
    "page-title": "20px",
    "card-title": "15px",
    "section-title": "14px",
    "body": "13px",
    "label": "12px",
    "meta": "11px",
    "technical": "10px"
  },

  "radius": {
    "card": "16px",
    "panel": "12px",
    "control": "8px"
  },

  "control": {
    "standard": "32px",
    "primary": "36px"
  },

  "space": {
    "micro": "4px",
    "base": "8px",
    "snug": "12px",
    "local": "16px",
    "major": "24px"
  },

  "shell": {
    "sidebar-width": "232px",
    "topbar-height": "52px",
    "content-padding": "24px",
    "nav-row-height": "36px",
    "nav-row-width": "208px",
    "nav-icon-size": "18px",
    "min-width": "1180px"
  },

  "blur": {
    "glass": "24px",
    "orb": "96px"
  },

  "themes": {
    "dark": {
      "bg-top": "#0A0B0E",
      "bg-bottom": "#050608",
      "orb": "rgba(94, 106, 210, 0.08)",
      "glass": "rgba(255, 255, 255, 0.050)",
      "glass-elevated": "rgba(255, 255, 255, 0.075)",
      "glass-border": "rgba(255, 255, 255, 0.085)",
      "glass-inset": "rgba(255, 255, 255, 0.055)",
      "glass-shadow": "0 12px 40px rgba(0, 0, 0, 0.34)",
      "recessed": "rgba(0, 0, 0, 0.20)",
      "recessed-border": "rgba(255, 255, 255, 0.07)",
      "text-primary": "#EDEEF2",
      "text-secondary": "#9298A3",
      "text-muted": "#69717D",
      "text-disabled": "#4E5560"
    },
    "light": {
      "bg-top": "#F7F8FA",
      "bg-bottom": "#ECEEF2",
      "orb": "rgba(94, 106, 210, 0.10)",
      "glass": "rgba(255, 255, 255, 0.64)",
      "glass-elevated": "rgba(255, 255, 255, 0.78)",
      "glass-border": "rgba(18, 26, 38, 0.085)",
      "glass-inset": "rgba(255, 255, 255, 0.70)",
      "glass-shadow": "0 12px 40px rgba(23, 31, 45, 0.09)",
      "recessed": "rgba(228, 231, 237, 0.52)",
      "recessed-border": "rgba(18, 26, 38, 0.08)",
      "text-primary": "#17191E",
      "text-secondary": "#606875",
      "text-muted": "#858E9A",
      "text-disabled": "#A5ABB4"
